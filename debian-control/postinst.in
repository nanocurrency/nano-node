#!/usr/bin/env bash

set +e

useradd -r celerixcurrency
groupadd -r celerixcurrency

mkdir -p /var/celerixcurrency/Celerix
mkdir -p /var/celerixcurrency/CelerixBeta
mkdir -p /var/celerixcurrency/CelerixTest
chown -R celerixcurrency: /var/celerixcurrency

systemctl stop ${CELERIX_SERVICE} 2>/dev/null
systemctl disable ${CELERIX_SERVICE} 2>/dev/null
cp ${CMAKE_INSTALL_PREFIX}/extras/systemd/${CELERIX_SERVICE} /etc/systemd/system/${CELERIX_SERVICE}
systemctl daemon-reload
systemctl enable ${CELERIX_SERVICE}
systemctl start ${CELERIX_SERVICE}
sleep 1
systemctl --no-pager status ${CELERIX_SERVICE}

set -e
